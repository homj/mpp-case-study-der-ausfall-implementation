{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ausfall/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ausfall/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "api-attach",
      "url": "http://localhost:4000",
      "port": 4000
    }
  ]
}
